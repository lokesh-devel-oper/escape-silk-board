# Exact comma-separated browser origins allowed to call FastAPI directly.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional Gemini configuration. Leave both empty for deterministic mode.
# Never commit a real API key.
GEMINI_API_KEY=
GEMINI_MODEL=

# Bounded AI reliability settings.
GEMINI_TIMEOUT_SECONDS=5
GEMINI_MAX_RETRIES=1
GEMINI_MIN_CONFIDENCE=0.55
