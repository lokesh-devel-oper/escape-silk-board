# Docker Compose host ports.
APP_PORT=18080

# Exact comma-separated browser origins allowed to call FastAPI directly.
# These defaults support both the Vite dev server and Dockerized frontend.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:18080,http://127.0.0.1:18080
DOCKER_ALLOWED_ORIGINS=http://localhost:18080,http://127.0.0.1:18080

# Optional Gemini configuration. Leave both empty for deterministic mode.
# Never commit a real API key.
GEMINI_API_KEY=
GEMINI_MODEL=

# Bounded AI reliability settings.
GEMINI_TIMEOUT_SECONDS=5
GEMINI_MAX_RETRIES=1
GEMINI_MIN_CONFIDENCE=0.55
